# ── shivamStudio API ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
 
# Runtime connection (role `shivamstudio_app`: no superuser, no BYPASSRLS → row-level security always applies).
DATABASE_URL=postgres://shivamstudio_app:CHANGE_ME@localhost:5432/shivamstudio
# Owner role used ONLY by `npm run db:migrate` / `db:seed`. Falls back to DATABASE_URL if omitted.
MIGRATE_DATABASE_URL=postgres://shivamstudio_owner:CHANGE_ME@localhost:5432/shivamstudio
 
# JWT signing secret (>= 32 chars). Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN_HOURS=168
 
# Session cookie. Same-site deployments (app + api under one registrable domain) keep `lax`.
# Studios on their own custom domains calling a different API domain need COOKIE_SAMESITE=none (requires HTTPS; sets Secure).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
 
# CORS + CSRF origin allow-list (comma separated). Tenant subdomains of PLATFORM_BASE_DOMAIN and every active tenant
# custom_domain are allowed automatically; list your dev origins here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLATFORM_BASE_DOMAIN=localhost
 
# Public `GET /tenants/public` (dev tenant switcher). Disable in production.
ENABLE_PUBLIC_TENANT_LIST=true
 
# Behind a reverse proxy / load balancer, set the number of hops so rate limiting sees real client IPs.
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=600
LOG_LEVEL=info