# ---- Data mode --------------------------------------------------------------
# mock : everything runs from src/data/mock/*.json (persisted to localStorage). No backend needed.
# api  : the same service interfaces call the Node.js REST API below.
VITE_DATA_MODE=mock
VITE_API_BASE_URL=http://localhost:5000/api/v1
 
# ---- Tenant resolution ------------------------------------------------------
# Subdomain tenants: royal.<VITE_BASE_DOMAIN>  (leave empty for local dev)
VITE_BASE_DOMAIN=
# Hostnames that always use path-based tenants (/royal, /dream) instead of host lookup.
VITE_PLATFORM_HOSTS=localhost,127.0.0.1
# Slug used when the root URL is opened in path mode and you want to skip the studio picker (optional).
VITE_DEFAULT_TENANT=
# Show the floating "switch studio" dev widget (true in development).
VITE_DEV_TENANT_SWITCHER=true